# ── Required MTProto bot credentials ─────────────────────────────────────────
# Bot token: create the bot with @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_botfather_token

# Create these at https://my.telegram.org/apps. They are NOT the bot token.
# Put both values in Koyeb Secrets; do not send them in chat or commit them.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_with_the_32_character_hex_api_hash

# Optional owner-only mode. Leave blank to allow private-chat users.
ALLOWED_USER_IDS=
ALLOW_GROUPS=false

# ── Data / privacy ───────────────────────────────────────────────────────────
DATA_DIR=/data
SOURCE_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=60
KEEP_JOB_ARTIFACTS=false

# ── Application caps ─────────────────────────────────────────────────────────
# Zero means no application-enforced cap. Telegram, storage, RAM, CPU/GPU and
# per-file Telegram service limits still physically apply.
MAX_IMAGE_MB=0
MAX_VIDEO_MB=0
MAX_VIDEO_SECONDS=0
MAX_VIDEO_SIDE=0
MAX_JOBS_PER_USER=0
QUEUE_MAX_SIZE=0
JOB_TIMEOUT_SECONDS=0

# The worker checks live free disk space before a render. Attach a large Koyeb
# /data volume; memory workflow avoids a complete PNG-frame cache.
WORKSPACE_HEADROOM_MB=1024

# Telegram bots cannot send one file above the service cap. The worker sends
# larger completed renders as ordered lossless parts automatically.
TELEGRAM_UPLOAD_PART_MB=1900
SPLIT_LARGE_RESULTS=true

# ── High-quality FaceFusion profile ──────────────────────────────────────────
# CPU works but is slow for long or high-resolution video. Use CUDA on a
# compatible GPU deployment for practical large-file performance.
EXECUTION_PROVIDER=cpu
EXECUTION_THREADS=2
FACEFUSION_MODEL=hyperswap_1a_256
FACE_SWAPPER_PIXEL_BOOST=512x512
FACE_SELECTOR_MODE=reference
# In reference mode, the intended target face must be visible in this frame.
REFERENCE_FRAME_NUMBER=0
REFERENCE_FACE_POSITION=0
REFERENCE_FACE_DISTANCE=0.30
FACE_TRACKER_SCORE=0.0
FACE_DETECTOR_MODEL=yolo_face
FACE_DETECTOR_SIZE=640x640
FACE_DETECTOR_SCORE=0.50
FACE_MASK_TYPES=box occlusion
# memory still processes every frame; it avoids storing every frame as PNG.
WORKFLOW_STRATEGY=memory

# Set true only for unusual codecs that FaceFusion/FFmpeg cannot read directly.
# With false, original dimensions are retained and no input re-encode is added.
NORMALIZE_INPUT=false
OUTPUT_VIDEO_QUALITY=95
OUTPUT_VIDEO_PRESET=medium
NORMALIZE_CRF=18

# Keep a visible disclosure label for responsible sharing.
WATERMARK_OUTPUT=true
WATERMARK_TEXT=AI face swap

# ── Telegram FloodWait / reliability control ─────────────────────────────────
# Telethon exposes every FloodWait to a durable guard. Important actions wait
# asynchronously for Telegram's exact deadline; progress edits are coalesced
# and dropped while rate-limited so rendering never pauses.
PROGRESS_EDIT_SECONDS=2.5
TELEGRAM_GLOBAL_ACTION_INTERVAL_SECONDS=0.08
TELEGRAM_CHAT_ACTION_INTERVAL_SECONDS=0.80
TELEGRAM_MAX_FLOOD_WAIT_SECONDS=86400
TELEGRAM_MAX_FLOOD_RETRIES=12
TELEGRAM_TRANSIENT_RETRIES=6
TELEGRAM_RETRY_BASE_SECONDS=1.0
LOG_LEVEL=INFO
